# Run npm run setup for generated LOCAL secrets. Never commit .env.local.
DATABASE_URL=postgresql://festival:local-only@127.0.0.1:54329/festival
# Neon: use a pooled URL above and the direct URL below for migrations.
DIRECT_DATABASE_URL=
APP_URL=http://localhost:3000
APP_MODE=development
# live deployments only: staging (rzp_test_ keys) or production (rzp_live_ keys)
DEPLOY_ENV=
SESSION_SECRET=
CREDENTIAL_KEY=
PAYMENT_PROVIDER=development
OTP_PROVIDER=development
# Set PAYMENT_PROVIDER=razorpay to take live Checkout even while APP_MODE=development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# Composio Gmail (free sender for OTP email). Connect via: composio + Gmail OAuth.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
COMPOSIO_CONNECTED_ACCOUNT_ID=
# httpSMS (https://httpsms.com/settings). Set OTP_PROVIDER=httpsms to send login codes by SMS.
HTTPSMS_API_KEY=
HTTPSMS_FROM=
SMS_API_URL=
SMS_API_TOKEN=
CRON_SECRET=
# Ticket-confirmation SMS (REQUIRED in live mode: a verified mobile is needed to buy).
# SMS_PROVIDER=msg91|httpsms|generic. MSG91: MSG91_TEMPLATE_ID is the MSG91 flow template, linked to
# the DLT-approved template (and its DLT template ID / sender header) in the MSG91 panel.
# MSG91_TEMPLATE_VARIABLES maps the template's variable names to REFERENCE, SHOW, LINK, NAME.
# SMS_CONFIRMATION_TEXT is the free-text wording (httpSMS/generic) and must match the approved template.
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_TEMPLATE_VARIABLES=REFERENCE=REFERENCE,SHOW=SHOW,LINK=LINK
SMS_CONFIRMATION_TEXT="Your Ganabhawan ticket booking {REFERENCE} is confirmed for {SHOW}. View your tickets: {LINK}"
# Worker tick batch sizes (defaults 2/3/2 fit the Workers Free plan's 50 subrequests). Raise on Workers Paid.
# WORKER_JOB_BATCH=2
# WORKER_RECONCILE_BATCH=3
# WORKER_REFUND_BATCH=2
# Upper bound for one Neon HTTP query in ms (a timed-out statement is never resent).
# DB_QUERY_TIMEOUT_MS=25000
# Staff MFA is enrolled per user with: npm run db:staff -- mfa-enroll <email>
# Bearer token for an external monitor on /api/ops/status (16+ chars)
OPS_MONITOR_TOKEN=
ALLOW_PUBLIC_SALES=false
CHROMA_URL=http://127.0.0.1:8000
CHROMA_COLLECTION=ganabhawan_catalogue
# Clerk (Google OAuth). Generated by `npx clerk@latest init` or Dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/catalogue
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/catalogue
FESTIVAL_CONTACT_EMAIL=tickets@samatat.org
# Admin dashboard (email + password). Run: npm run db:admin
ADMIN_EMAIL=srksourabh@gmail.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Sourabh
