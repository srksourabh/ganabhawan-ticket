{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ganabhawan-festival",
  "account_id": "284e2fb6036048cc75fd24df7712d03e",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  // One background tick every 10 minutes (worker/index.ts scheduled → /api/cron/worker).
  // A per-minute tick kept the Neon compute awake 24/7 and exhausted the free-plan
  // compute-hours quota (HTTP 402 on every query). Holds live 10 minutes, so a
  // 10-minute cadence still reclaims them promptly while letting Neon auto-suspend.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
