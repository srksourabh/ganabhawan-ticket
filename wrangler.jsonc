{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ganabhawan-festival",
  "account_id": "284e2fb6036048cc75fd24df7712d03e",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  // One background tick per minute (worker/index.ts scheduled → /api/cron/worker).
  "triggers": {
    "crons": ["* * * * *"]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
