{
  "name": "ganabhawan-festival",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "setup": "tsx scripts/setup.ts",
    "db:local": "tsx scripts/local-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:admin": "tsx scripts/set-admin.ts",
    "worker": "tsx scripts/worker.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:secrets": "node scripts/push-cf-secrets.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.1",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/noto-sans-bengali": "5.3.0",
    "@neondatabase/serverless": "^1.0.2",
    "@phosphor-icons/react": "2.1.10",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "@zxing/browser": "0.2.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "pdf-lib": "1.17.1",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "unrs-resolver@1.12.2": true
  }
}
